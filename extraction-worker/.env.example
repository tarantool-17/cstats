DATABASE_URL=postgres://cstats:cstats_dev_password@localhost:5432/cstats
IMAGE_STORAGE_ROOT=/tmp/cstats/images
WORKER_POLL_INTERVAL_MS=5000
WORKER_ID=local-worker

# In Docker Compose these are injected by the scoreboard_model binding.
# For running the worker directly against Docker Desktop Model Runner, use:
# SCOREBOARD_MODEL_URL=http://localhost:12434/engines/v1
# SCOREBOARD_MODEL_NAME=ai/qwen3-vl:8B-Q8_K_XL
SCOREBOARD_MODEL_MAX_TOKENS=2048
SCOREBOARD_MODEL_TIMEOUT_MS=180000
